{
    "name": "crustum/plugin-manifest",
    "description": "Plugin Manifest System - Install plugin assets, configs, migrations, and bootstrap code to CakePHP applications",
    "type": "cakephp-plugin",
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "cakephp/cakephp": "6.x-dev",
        "crustum/prompts": "2.x-dev",
        "crustum/inspector": "2.x-dev"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "6.x-dev",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.7"
   },
    "autoload": {
        "psr-4": {
            "Crustum\\PluginManifest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\PluginManifest\\Test\\": "tests/",
            "TestApp\\": "tests/TestApp/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "phpunit --coverage-html coverage",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/",
        "stan-baseline": "phpstan analyse --generate-baseline"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": false
    }
}
